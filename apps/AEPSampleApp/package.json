{
  "name": "aepsampleapp",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build:matrix": "bash scripts/build-matrix.sh",
    "build:matrix:list": "bash scripts/build-matrix.sh --list-matrix",
    "build:ios:turbo": "bash scripts/build-matrix.sh --preset ios-turbo -c full --sync --run",
    "build:ios:interop": "bash scripts/build-matrix.sh --preset ios-interop -c full --sync --run",
    "build:android:turbo": "bash scripts/build-matrix.sh --preset android-turbo -c full --sync --run",
    "build:android:interop": "bash scripts/build-matrix.sh --preset android-interop -c full --sync --run",
    "build:both:turbo": "bash scripts/build-matrix.sh --preset both-turbo -c full --sync --run",
    "build:both:interop": "bash scripts/build-matrix.sh --preset both-interop -c full --sync --run",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@adobe/react-native-aepassurance": "portal:../../packages/assurance",
    "@adobe/react-native-aepcampaignclassic": "portal:../../packages/campaignclassic",
    "@adobe/react-native-aepcore": "portal:../../packages/core",
    "@adobe/react-native-aepedge": "portal:../../packages/edge",
    "@adobe/react-native-aepedgebridge": "portal:../../packages/edgebridge",
    "@adobe/react-native-aepedgeconsent": "portal:../../packages/edgeconsent",
    "@adobe/react-native-aepedgeidentity": "portal:../../packages/edgeidentity",
    "@adobe/react-native-aepmessaging": "portal:../../packages/messaging",
    "@adobe/react-native-aepoptimize": "portal:../../packages/optimize",
    "@adobe/react-native-aepplaces": "portal:../../packages/places",
    "@adobe/react-native-aeptarget": "portal:../../packages/target",
    "@adobe/react-native-aepuserprofile": "portal:../../packages/userprofile",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-masked-view/masked-view": "^0.3.0",
    "@react-native/new-app-screen": "0.85.2",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/drawer": "^7.8.0",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/stack": "^7.4.2",
    "lodash.isequal": "^4.5.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.24.0",
    "react-native-webview": "^13.14.1",
    "react-native-worklets": "^0.9.0",
    "recyclerlistview": "^4.2.0",
    "ts-object-utils": "0.0.5",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.0",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "installConfig": {
    "hoistingLimits": "workspaces",
    "selfReferences": false
  },
  "rnx-kit": {
    "kitType": "app",
    "alignDeps": {
      "requirements": [
        "react-native@0.85"
      ],
      "capabilities": [
        "animation",
        "babel-preset-react-native",
        "community/cli",
        "community/cli-android",
        "community/cli-ios",
        "core",
        "core-android",
        "core-ios",
        "core/metro-config",
        "gestures",
        "jest",
        "masked-view",
        "navigation/native",
        "navigation/stack",
        "react",
        "react-test-renderer",
        "safe-area",
        "screens",
        "webview"
      ]
    }
  }
}
