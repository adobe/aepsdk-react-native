{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // allowJs (from the RN base config) makes TypeScript silently treat
    // a package with a missing .d.ts as implicit `any` instead of
    // raising TS7016 — masking exactly the issue-593 regression this
    // check exists to catch. Disabled here only, not in the real app.
    "allowJs": false
  },
  "include": ["scripts/verify-consumer-types.ts"]
}
